APP_ENV=local
DATABASE_URL=postgresql+psycopg://localhost:5432/grocea
TEST_DATABASE_URL=postgresql+psycopg://localhost:5432/grocea_test
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=localhost,127.0.0.1,::1,testserver
AUTH_COOKIE_SAMESITE=lax
LOG_LEVEL=INFO
API_LOG_CAPACITY=500
# Recovery is unavailable until host/from/origin and a stable throttle secret are configured.
PUBLIC_APP_ORIGIN=http://127.0.0.1:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TIMEOUT_SECONDS=5
RECOVERY_THROTTLE_SECRET=
RESET_TOKEN_MINUTES=30
RESET_REQUESTS_PER_HOUR=5
